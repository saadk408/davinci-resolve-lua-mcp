{
  "name": "resolve-lua-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server (MCPB bundle for Claude Desktop) that controls DaVinci Resolve 21.1 free edition on macOS through an in-app Lua bridge",
  "license": "MIT",
  "author": "Saad Khan",
  "engines": {
    "node": ">=20"
  },
  "main": "server/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/index.js --log-level=warning",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
